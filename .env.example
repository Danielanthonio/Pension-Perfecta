# Supabase
NEXT_PUBLIC_SUPABASE_URL=tu_supabase_url_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Llave de servicio (service_role) — SOLO servidor, NUNCA con prefijo NEXT_PUBLIC.
# Requerida para eliminar usuarios permanentemente (endpoint /api/admin/delete-user).
# Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# GoHighLevel — sub-cuenta de la que se leen los contactos (Private Integration Token).
# SOLO servidor, NUNCA con prefijo NEXT_PUBLIC: expone el padrón completo de contactos.
# GHL → Settings → Private Integrations. Scopes mínimos: View Contacts,
# View Opportunities, View Calendars (+ View Calendar Events si se necesitan las citas).
GHL_API_TOKEN=tu_private_integration_token_aqui
GHL_LOCATION_ID=tu_location_id_aqui
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28

# Secreto del barrido nocturno de GoHighLevel (.github/workflows/sincronizar-ghl.yml).
# La MISMA cadena tiene que estar aquí y en los secretos del repositorio en GitHub.
# Genérala con:  openssl rand -hex 32
# Si NO se configura, la puerta del secreto no existe y /api/ghl/sincronizar-todo
# solo responde a una sesión de Dirección. Es a propósito: mejor cerrada que
# abierta con un secreto adivinable.
CRON_SECRET=

# Puedes renombrar este archivo a .env.local e ingresar tus credenciales reales.
